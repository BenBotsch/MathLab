{
  "additionalProperties": false,
  "description": "A publication or other external source referenced by knowledge entries.",
  "properties": {
    "authors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "id",
    "version",
    "created_at",
    "title"
  ],
  "title": "PublicationSource",
  "type": "object"
}
