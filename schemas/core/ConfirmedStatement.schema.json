{
  "additionalProperties": false,
  "description": "The confirmed, immutable formal target of a problem.",
  "properties": {
    "change_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Reason"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "formal_statement_id": {
      "format": "uuid",
      "title": "Formal Statement Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "imports": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Imports",
      "type": "array"
    },
    "lean_code": {
      "minLength": 1,
      "title": "Lean Code",
      "type": "string"
    },
    "problem_id": {
      "format": "uuid",
      "title": "Problem Id",
      "type": "string"
    },
    "statement_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Statement Hash",
      "type": "string"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "toolchain": {
      "description": "e.g. leanprover/lean4:v4.x",
      "minLength": 1,
      "title": "Toolchain",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "created_at",
    "problem_id",
    "formal_statement_id",
    "lean_code",
    "toolchain",
    "statement_hash"
  ],
  "title": "ConfirmedStatement",
  "type": "object"
}
