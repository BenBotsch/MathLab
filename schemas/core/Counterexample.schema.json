{
  "$defs": {
    "JsonValue": {},
    "SourceKind": {
      "description": "Where a claim comes from.",
      "enum": [
        "AGENT",
        "VERIFIER",
        "LIBRARY",
        "PUBLICATION",
        "HUMAN",
        "SIMULATION",
        "SYMBOLIC_ENGINE"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "The origin of a claim: a kind plus an identifier within that kind.",
      "properties": {
        "identifier": {
          "description": "e.g. agent id, entity UUID, Mathlib name",
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        }
      },
      "required": [
        "kind",
        "identifier"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A concrete assignment that is claimed to falsify a formal statement.",
  "properties": {
    "artifact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact"
    },
    "assignment": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Assignment",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "formal_statement_id": {
      "format": "uuid",
      "title": "Formal Statement Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "created_at",
    "formal_statement_id",
    "assignment"
  ],
  "title": "Counterexample",
  "type": "object"
}
