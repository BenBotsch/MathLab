            "additionalProperties": {
              "$ref": "#/components/schemas/AgentView"
            },
            "title": "Agents",
            "type": "object"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "sequence",
          "agents"
        ],
        "title": "AgentGraph",
        "type": "object"
      },
      "AgentStatus": {
        "description": "Technical process state of an agent or task. Says nothing about mathematical validity.",
        "enum": [
          "RUNNING",
          "FINISHED",
          "FAILED",
          "PAUSED",
          "CANCELLED"
        ],
        "title": "AgentStatus",
        "type": "string"
      },
      "AgentView": {
        "additionalProperties": false,
        "properties": {
          "agent_version": {
            "title": "Agent Version",
            "type": "string"
          },
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus"
          }
        },
        "required": [
          "agent_version",
          "execution_id",
          "status"
        ],
        "title": "AgentView",
        "type": "object"
      },
      "AttemptView": {
        "additionalProperties": false,
        "properties": {
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationStatus",
            "default": "OPEN"
          },
          "verification_result_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Result Id"
          }
        },
        "title": "AttemptView",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Body of every error response.",
        "properties": {
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorType"
          },
          "failure_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureCode"
              },
              {
                "type": "null"
              }
            ]
