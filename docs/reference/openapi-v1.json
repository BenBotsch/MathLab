        "type": "string"
      },
      "RunSummary": {
        "additionalProperties": false,
        "properties": {
          "last_sequence": {
            "title": "Last Sequence",
            "type": "integer"
          },
          "pause_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pause Reason"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "run_id",
          "status",
