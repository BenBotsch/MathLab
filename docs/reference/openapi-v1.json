{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Body of every error response.",
        "properties": {
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorType"
          },
          "failure_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailureCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "trace_id": {
            "format": "uuid",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message",
          "trace_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ErrorType": {
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "DOMAIN_FAILURE",
          "TIMEOUT",
          "CANCELLED",
          "UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorType",
        "type": "string"
      },
      "FailureCode": {
        "description": "The failure catalogue of ARCH §9.3.",
        "enum": [
          "SYNTAX_ERROR",
          "TYPE_ERROR",
          "MISSING_LEMMA",
          "INVALID_INFERENCE",
          "COUNTEREXAMPLE_FOUND",
          "SEARCH_EXHAUSTED",
          "CIRCULAR_DEPENDENCY",
          "SEMANTIC_MISMATCH",
          "RESOURCE_EXHAUSTION"
        ],
        "title": "FailureCode",
        "type": "string"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "Health",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MathLab API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Client error"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
