            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "Health",
        "type": "object"
      },
      "MetricsView": {
        "additionalProperties": false,
        "properties": {
          "events_by_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "default": {},
            "title": "Events By Type",
            "type": "object"
          },
          "failures_by_code": {
            "additionalProperties": {
              "type": "integer"
            },
            "default": {},
            "title": "Failures By Code",
            "type": "object"
          },
