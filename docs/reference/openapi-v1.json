          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "trace_id": {
            "format": "uuid",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "message",
          "trace_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ErrorType": {
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "DOMAIN_FAILURE",
          "TIMEOUT",
          "CANCELLED",
          "UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorType",
        "type": "string"
      },
      "FailureCode": {
        "description": "The failure catalogue of ARCH §9.3.",
        "enum": [
          "SYNTAX_ERROR",
          "TYPE_ERROR",
          "MISSING_LEMMA",
          "INVALID_INFERENCE",
          "COUNTEREXAMPLE_FOUND",
          "SEARCH_EXHAUSTED",
          "CIRCULAR_DEPENDENCY",
          "SEMANTIC_MISMATCH",
          "RESOURCE_EXHAUSTION"
