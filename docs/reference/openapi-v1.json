        "additionalProperties": false,
        "description": "Replay result with its origin.",
        "properties": {
          "sequence": {
            "description": "Last event contained in the state.",
            "minimum": 0.0,
            "title": "Sequence",
            "type": "integer"
          },
          "snapshot_sequence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
