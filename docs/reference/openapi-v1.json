            "default": 0,
            "title": "Model Calls Used",
            "type": "integer"
          },
          "runtime_seconds_used": {
            "default": 0.0,
            "title": "Runtime Seconds Used",
            "type": "number"
          },
          "steps_proposed": {
            "default": 0,
            "title": "Steps Proposed",
            "type": "integer"
          },
          "steps_rejected": {
            "default": 0,
            "title": "Steps Rejected",
            "type": "integer"
          },
          "steps_verified": {
            "default": 0,
            "title": "Steps Verified",
            "type": "integer"
          },
          "tokens_used": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokens Used"
          }
        },
        "title": "MetricsView",
        "type": "object"
      },
      "NodeView": {
        "additionalProperties": false,
        "properties": {
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "parent_node_id": {
