      "StepView": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "default": false,
            "title": "Accepted",
            "type": "boolean"
          },
          "attempt_id": {
            "format": "uuid",
            "title": "Attempt Id",
            "type": "string"
          },
          "proof_node_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proof Node Id"
          },
          "tactic": {
            "title": "Tactic",
            "type": "string"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationStatus",
            "default": "OPEN"
          },
          "verification_result_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Result Id"
          }
        },
        "required": [
          "attempt_id",
          "tactic",
          "proof_node_id"
        ],
        "title": "StepView",
        "type": "object"
      },
      "VerificationStatus": {
        "description": "Outcome of a trusted proof checker for one artifact (UI §1.3).",
        "enum": [
          "VERIFIED",
          "OPEN",
          "REJECTED"
        ],
        "title": "VerificationStatus",
        "type": "string"
      }
    }
